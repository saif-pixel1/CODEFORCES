import sys
 
input = sys.stdin.readline
 
def solve(n,k,arr):
    for i in range(n):
        if k in arr:
            return "YES"
        else:
            return "NO"
 
def main():
    t = int(input())
    for _ in range(t):
        n,k = map(int,input().split(" "))
        arr = list(map(int, input().split(" ")))        
        print(solve(n,k,arr))
        
if __name__ == "__main__":
    main()