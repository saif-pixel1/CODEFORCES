import sys
 
input = sys.stdin.readline
 
def solve():
    n,k = map(int, input().split())
    a = list(map(int, input().split()))
    b = list(map(int, input().split()))
    c=0
    co=0
    i=0
    if k%2 == 0:
        while i<n:
            if a[i]%2 == 0:
                c += 1
            if b[i]%2 == 0:
                co += 1
            i += 1
        if c <= co:
            return "YES"
 
    elif k%2 != 0:
        while i<n:
            if a[i]%2 == 0:
                c += 1
            if b[i]%2 == 0:
                co += 1
            i += 1
        if c >= co:
            return "YES"
 
    return "NO"
 
def main():
 
    t = int(input())
    for _ in range(t):
        print(solve())
 
if __name__ == "__main__":
    main()